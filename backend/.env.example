# Server Configuration
PORT=5000
HOST=127.0.0.1
NODE_ENV=development

# Auth
# Rahasia penandatangan JWT. Bila kosong, dibuat otomatis dan disimpan di
# backend/.jwt_secret. Di produksi WAJIB diisi string acak panjang.
JWT_SECRET=

# Database Configuration (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=123
DB_NAME=teraflowid

# Partisi tabel readings (dipakai oleh npm run partitions)
READINGS_PARTITION_MONTHS_AHEAD=3
READINGS_RETENTION_MONTHS=0

# MQTT Broker Configuration
MQTT_PORT=1883
MQTT_HOST=127.0.0.1
EMBEDDED_MQTT=true
MQTT_URL=mqtt://127.0.0.1:1883
# Kredensial broker (kosongkan bila broker tanpa autentikasi)
MQTT_USER=
MQTT_PASS=

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
